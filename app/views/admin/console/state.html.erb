<%# The persisted state of one call: what a browser loads on first render, on a refresh, and after an Action Cable reconnect. %>
<turbo-frame id="call-state" class="min-w-0 block"><div class="space-y-3"><%= render "admin/console/call_status", call_log: @call_log %><%= render "admin/console/order_board", call_log: @call_log %></div></turbo-frame>
<turbo-frame id="call-events" class="min-w-0 block"><%= render "admin/console/events", call_log: @call_log %></turbo-frame>
