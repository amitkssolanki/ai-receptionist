<% board = ConsoleView::Board.new(call_log) %>
<section id="order-board" class="rounded border border-gray-800 bg-gray-900" data-cart-version="<%= board.cart_version %>" data-order-status="<%= board.status %>">
  <header class="flex items-center justify-between border-b border-gray-800 px-4 py-2 text-xs">
    <span class="font-semibold tracking-wide">ORDER BOARD</span>
    <span class="rounded bg-gray-800 px-2 py-0.5 text-gray-400">source: RAILS · authoritative</span>
  </header>
  <% if board.present? %>
    <div class="px-4 py-3 text-sm">
      <div class="flex items-center justify-between">
        <span class="font-semibold">ORDER #<%= board.order_id %></span>
        <span class="<%= board.locked? ? 'text-emerald-400' : 'text-amber-400' %> font-semibold"><%= board.status_label %><%= " 🔒" if board.locked? && board.status == "confirmed" %><%= board.fulfillment ? " · #{board.fulfillment}" : "" %></span>
      </div>
      <div class="my-2 border-t border-gray-800"></div>
      <% if board.lines.empty? %>
        <p class="text-gray-500">No items in the cart.</p>
      <% else %>
        <ul class="space-y-1">
          <% board.lines.each do |line| %>
            <li>
              <div class="flex justify-between"><span><%= line.quantity %> × <%= line.name %></span><span>$<%= "%.2f" % line.subtotal %></span></div>
              <% line.modifiers.each do |modifier| %>
                <div class="flex justify-between pl-4 text-xs text-gray-400"><span>+ <%= modifier[:name] %></span><span>$<%= "%.2f" % modifier[:price] %></span></div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% board.repeated_items.each do |repeat| %>
        <p data-repeated-item class="mt-2 text-xs text-amber-400">⚠ <%= repeat[:name] %> is on <%= repeat[:lines] %> lines of the cart. If the caller meant to change it, the earlier line is still there.</p>
      <% end %>
      <div class="my-2 border-t border-gray-800"></div>
      <div class="flex justify-between font-semibold"><span>TOTAL</span><span>$<%= "%.2f" % board.total %></span></div>
      <dl class="mt-3 grid grid-cols-[6.5rem_1fr] gap-y-1 text-xs">
        <dt class="text-gray-500">cart version</dt><dd class="font-semibold">v<%= board.cart_version %></dd>
        <dt class="text-gray-500">read-back</dt><dd class="<%= board.read_back_stale? ? 'text-amber-400 font-semibold' : '' %>"><%= board.read_back %></dd>
        <dt class="text-gray-500">confirmation</dt><dd><%= board.confirmation %></dd>
        <dt class="text-gray-500">sms</dt><dd><%= board.sms %></dd>
      </dl>
    </div>
  <% else %>
    <p class="px-4 py-3 text-sm text-gray-500">No cart yet. Nothing has been added on the server.</p>
  <% end %>
</section>
