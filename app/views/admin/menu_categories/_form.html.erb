<%= form_with model: [ :admin, menu_category ], class: "space-y-4 max-w-md" do |f| %>
  <% if menu_category.errors.any? %>
    <p class="text-red-600 text-sm"><%= menu_category.errors.full_messages.to_sentence %></p>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :position, class: "block text-sm font-medium mb-1" %>
    <%= f.number_field :position, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <%= f.submit class: "bg-gray-900 text-white text-sm px-4 py-2 rounded cursor-pointer" %>
<% end %>
