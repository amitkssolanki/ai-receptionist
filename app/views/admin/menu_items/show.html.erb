<% content_for :title, @menu_item.name %>

<%= link_to "← #{@menu_item.menu_category.name}", admin_menu_category_menu_items_path(@menu_item.menu_category), class: "text-sm text-gray-500" %>

<div class="flex items-center justify-between mt-2 mb-6">
  <div>
    <h1 class="text-2xl font-semibold"><%= @menu_item.name %></h1>
    <p class="text-gray-500 text-sm"><%= @menu_item.description %></p>
  </div>
  <div class="text-right">
    <p class="text-xl font-semibold">$<%= "%.2f" % @menu_item.price %></p>
    <%= link_to "Edit", edit_admin_menu_item_path(@menu_item), class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
</div>

<section class="max-w-md">
  <h2 class="text-lg font-medium mb-3">Modifiers</h2>

  <% if @menu_item.menu_item_modifiers.any? %>
    <ul class="divide-y divide-gray-200 bg-white rounded border border-gray-200 mb-4">
      <% @menu_item.menu_item_modifiers.each do |modifier| %>
        <li class="px-4 py-3 flex items-center justify-between">
          <span><%= modifier.name %> <span class="text-gray-500 text-sm">(+$<%= "%.2f" % (modifier.price_cents / 100.0) %>)</span></span>
          <div class="flex gap-3 text-sm">
            <%= link_to "Edit", edit_admin_menu_item_modifier_path(modifier), class: "text-gray-600 hover:text-gray-900" %>
            <%= button_to "Delete", admin_menu_item_modifier_path(modifier), method: :delete, class: "text-red-600 hover:text-red-800 bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-sm mb-4">No modifiers yet.</p>
  <% end %>

  <%= link_to "Add modifier", new_admin_menu_item_menu_item_modifier_path(@menu_item), class: "text-sm text-gray-900 underline" %>
</section>

<section class="max-w-md mt-8">
  <h2 class="text-lg font-medium mb-3">Suggested alongside this item</h2>

  <% if @menu_item.upsell_items.any? %>
    <ul class="bg-white rounded border border-gray-200 divide-y divide-gray-200">
      <% @menu_item.upsell_items.each do |upsell| %>
        <li class="px-4 py-3"><%= upsell.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-sm">No suggestions set. <%= link_to "Edit item", edit_admin_menu_item_path(@menu_item), class: "underline" %> to add some.</p>
  <% end %>
</section>
