<div class="max-w-sm mx-auto mt-16 bg-white border border-gray-200 rounded p-8">
  <h2 class="text-2xl font-semibold mb-6">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <%= f.submit "Send me password reset instructions", class: "w-full bg-gray-900 text-white text-sm px-4 py-2 rounded cursor-pointer" %>
  <% end %>

  <div class="mt-4 text-sm text-gray-600">
    <%= render "devise/shared/links" %>
  </div>
</div>
