# Secrets for config/deploy.yml. This file is committed and holds NO values: each line reads its value from .env.kamal,
# which is git-ignored (/.env* in .gitignore and .dockerignore) and lives only on the deploying machine. Same convention
# as MCP Server and Platestead. docs/deploy/PRODUCTION.md lists every name and how to generate it.
# DO NOT ENTER RAW CREDENTIALS HERE. There is no RAILS_MASTER_KEY: production does not read config/credentials.yml.enc.

KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env.kamal | cut -d '=' -f2-)
SECRET_KEY_BASE=$(grep '^SECRET_KEY_BASE=' .env.kamal | cut -d '=' -f2-)

# The Postgres accessory's password, and the same value for Rails (config/database.yml).
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env.kamal | cut -d '=' -f2-)
AI_RECEPTIONIST_DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# Vapi: the production webhook secret, the restricted production browser key and the production assistant id.
VAPI_SERVER_SECRET=$(grep '^VAPI_SERVER_SECRET=' .env.kamal | cut -d '=' -f2-)
VAPI_PUBLIC_KEY=$(grep '^VAPI_PUBLIC_KEY=' .env.kamal | cut -d '=' -f2-)
VAPI_ASSISTANT_ID=$(grep '^VAPI_ASSISTANT_ID=' .env.kamal | cut -d '=' -f2-)

# One-time admin bootstrap (db/seeds.rb runs it only while the users table is empty). After the first deploy, empty
# ADMIN_PASSWORD in .env.kamal (leave the line as "ADMIN_PASSWORD=") and redeploy: runbook step 16.
ADMIN_EMAIL=$(grep '^ADMIN_EMAIL=' .env.kamal | cut -d '=' -f2-)
ADMIN_PASSWORD=$(grep '^ADMIN_PASSWORD=' .env.kamal | cut -d '=' -f2-)
